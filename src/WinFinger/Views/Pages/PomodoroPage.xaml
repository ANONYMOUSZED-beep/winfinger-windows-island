<UserControl x:Class="WinFinger.Views.Pages.PomodoroPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

        <TextBlock x:Name="PhaseLabel" Style="{StaticResource Text.Secondary}"
                   HorizontalAlignment="Center" Text="准备专注"/>

        <TextBlock x:Name="TimeLabel" FontFamily="{StaticResource Font.Display}" FontSize="64" FontWeight="Light"
                   Foreground="{StaticResource Brush.TextPrimary}" HorizontalAlignment="Center"
                   Margin="0,4,0,0" Text="25:00"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
            <Button x:Name="StartButton" Style="{StaticResource Button.Ghost}" Padding="18,9">
                <TextBlock x:Name="StartLabel" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.Green}" Text="开始专注"/>
            </Button>
            <Button x:Name="ResetButton" Style="{StaticResource Button.Ghost}" Content="重置" FontSize="13" Margin="8,0,0,0" Padding="18,9"/>
        </StackPanel>

        <!-- duration settings -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,26,0,0">
            <TextBlock Style="{StaticResource Text.Micro}" VerticalAlignment="Center" Text="专注"/>
            <Button x:Name="FocusMinus" Style="{StaticResource Button.Ghost}" Content="−" Margin="6,0,0,0" Padding="8,3"/>
            <TextBlock x:Name="FocusLabel" Style="{StaticResource Text.Body}" VerticalAlignment="Center"
                       MinWidth="46" TextAlignment="Center" Text="25 分钟"/>
            <Button x:Name="FocusPlus" Style="{StaticResource Button.Ghost}" Content="＋" Padding="8,3"/>

            <TextBlock Style="{StaticResource Text.Micro}" VerticalAlignment="Center" Margin="18,0,0,0" Text="休息"/>
            <Button x:Name="BreakMinus" Style="{StaticResource Button.Ghost}" Content="−" Margin="6,0,0,0" Padding="8,3"/>
            <TextBlock x:Name="BreakLabel" Style="{StaticResource Text.Body}" VerticalAlignment="Center"
                       MinWidth="40" TextAlignment="Center" Text="5 分钟"/>
            <Button x:Name="BreakPlus" Style="{StaticResource Button.Ghost}" Content="＋" Padding="8,3"/>
        </StackPanel>

        <TextBlock x:Name="StatsLabel" Style="{StaticResource Text.Micro}" Foreground="{StaticResource Brush.TextTertiary}"
                   HorizontalAlignment="Center" Margin="0,14,0,0" Text=""/>
    </StackPanel>
</UserControl>
