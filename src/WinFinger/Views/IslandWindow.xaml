<Window x:Class="WinFinger.Views.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WinFinger.Views"
        Title="WinFinger"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Width="980" Height="620"
        FontFamily="{StaticResource Font.Text}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <!-- The window is a fixed transparent stage; only IslandBorder animates. -->
    <Grid>
        <Border x:Name="IslandBorder"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,8,0,0"
                Width="300" Height="36"
                CornerRadius="18"
                Background="{StaticResource Brush.IslandBody}"
                BorderBrush="{StaticResource Brush.GlassRim}"
                BorderThickness="1.2"
                Cursor="Hand"
                MouseLeftButtonDown="OnIslandMouseDown"
                MouseLeftButtonUp="OnIslandClicked"
                MouseMove="OnIslandMouseMove"
                MouseEnter="OnIslandMouseEnter"
                MouseLeave="OnIslandMouseLeave">
            <Border.Effect>
                <DropShadowEffect x:Name="IslandShadow" Color="#000000" BlurRadius="32" ShadowDepth="6" Direction="270" Opacity="0.35"/>
            </Border.Effect>

            <Grid ClipToBounds="True">
                <!-- live frosted glass: blurred + saturation-boosted capture of what's behind -->
                <Border x:Name="GlassLayer" IsHitTestVisible="False"
                        CornerRadius="{Binding CornerRadius, ElementName=IslandBorder}"
                        RenderOptions.BitmapScalingMode="Fant">
                    <Border.Background>
                        <ImageBrush x:Name="GlassBrush" Stretch="Fill"/>
                    </Border.Background>
                </Border>

                <!-- adaptive tint: album accent bleeds into the glass while music plays -->
                <Border x:Name="TintLayer" IsHitTestVisible="False" Opacity="0"
                        CornerRadius="{Binding CornerRadius, ElementName=IslandBorder}">
                    <Border.Background>
                        <SolidColorBrush x:Name="TintBrush" Color="#000000"/>
                    </Border.Background>
                </Border>

                <!-- curved top reflection: scales with the island, fades out by ~45% height -->
                <Border Background="{StaticResource Brush.TopSheen}"
                        CornerRadius="{Binding CornerRadius, ElementName=IslandBorder}" IsHitTestVisible="False"/>

                <views:CompactIslandView x:Name="CompactView"/>

                <views:ExpandedPanelView x:Name="ExpandedView" Opacity="0" Visibility="Collapsed"/>

                <!-- transient notification bulge -->
                <Grid x:Name="NotificationView" Opacity="0" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="NotificationIcon" FontSize="13" VerticalAlignment="Center" Text="📋"/>
                        <TextBlock x:Name="NotificationText" Style="{StaticResource Text.Body}" FontSize="12"
                                   Margin="8,0,0,0" VerticalAlignment="Center" MaxWidth="340"
                                   TextTrimming="CharacterEllipsis" Text=""/>
                    </StackPanel>
                </Grid>

                <!-- inner dark edge: glass thickness -->
                <Border Margin="1" BorderThickness="1" BorderBrush="{StaticResource Brush.GlassInnerEdge}"
                        CornerRadius="{Binding CornerRadius, ElementName=IslandBorder}" IsHitTestVisible="False"/>

                <!-- chromatic dispersion along the bevel -->
                <Border Margin="1.4" BorderThickness="1" BorderBrush="{StaticResource Brush.ChromaticEdge}"
                        CornerRadius="{Binding CornerRadius, ElementName=IslandBorder}" IsHitTestVisible="False"/>

                <!-- breathing glints: light slowly travels between the two edges -->
                <Border x:Name="GlintA" BorderThickness="1.4" BorderBrush="{StaticResource Brush.GlintTopLeft}"
                        CornerRadius="{Binding CornerRadius, ElementName=IslandBorder}" IsHitTestVisible="False" Opacity="0.2"/>
                <Border x:Name="GlintB" BorderThickness="1.4" BorderBrush="{StaticResource Brush.GlintBottomRight}"
                        CornerRadius="{Binding CornerRadius, ElementName=IslandBorder}" IsHitTestVisible="False" Opacity="0.9"/>

                <!-- sheen band swept across on expand / notification -->
                <Border x:Name="SheenBand" Width="150" HorizontalAlignment="Left" Opacity="0"
                        Background="{StaticResource Brush.SheenSweep}" IsHitTestVisible="False">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <SkewTransform AngleX="-18"/>
                            <TranslateTransform x:Name="SheenTranslate" X="-200"/>
                        </TransformGroup>
                    </Border.RenderTransform>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
