<Window x:Class="WinFinger.Views.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WinFinger.Views"
        Title="WinFinger"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Width="980" Height="620"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <!-- The window is a fixed transparent stage; only IslandBorder animates. -->
    <Grid>
        <Border x:Name="IslandBorder"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,8,0,0"
                Width="300" Height="36"
                CornerRadius="18"
                Background="{StaticResource Brush.IslandBody}"
                BorderBrush="{StaticResource Brush.Stroke}"
                BorderThickness="1"
                Cursor="Hand"
                MouseLeftButtonUp="OnIslandClicked"
                MouseEnter="OnIslandMouseEnter"
                MouseLeave="OnIslandMouseLeave">
            <Border.Effect>
                <DropShadowEffect x:Name="IslandShadow" Color="#000000" BlurRadius="26" ShadowDepth="6" Direction="270" Opacity="0.55"/>
            </Border.Effect>

            <Grid ClipToBounds="True">
                <!-- top sheen -->
                <Border Height="14" VerticalAlignment="Top" Background="{StaticResource Brush.TopSheen}"
                        CornerRadius="18,18,0,0" IsHitTestVisible="False"/>

                <views:CompactIslandView x:Name="CompactView"/>

                <views:ExpandedPanelView x:Name="ExpandedView" Opacity="0" Visibility="Collapsed"/>

                <!-- transient notification bulge -->
                <Grid x:Name="NotificationView" Opacity="0" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="NotificationIcon" FontSize="13" VerticalAlignment="Center" Text="📋"/>
                        <TextBlock x:Name="NotificationText" Style="{StaticResource Text.Body}" FontSize="12"
                                   Margin="8,0,0,0" VerticalAlignment="Center" MaxWidth="340"
                                   TextTrimming="CharacterEllipsis" Text=""/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
